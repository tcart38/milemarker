PORT=3002
DATA_DIR=./.data
NODE_ENV=development
# Hostnames allowed in the Host header besides localhost/*.local/IP literals
# (DNS-rebinding protection). Comma-separated, e.g.: milemarker.home.lan,mybox
#ALLOWED_HOSTS=

# Optional login. Off unless AUTH_PASSWORD or AUTH_PASSWORD_HASH is set.
# AUTH_PASSWORD_HASH takes a bcrypt hash (node src/auth/hash-password.js).
#AUTH_USERNAME=admin
#AUTH_PASSWORD=
#AUTH_PASSWORD_HASH=
# Days a sign-in lasts without a visit (default 30)
#AUTH_SESSION_DAYS=30
# Signs session cookies; generated into DATA_DIR/.session-secret if unset
#SESSION_SECRET=
# Which proxies' X-Forwarded-* headers to trust (Express "trust proxy").
# Default trusts private-network addresses; set false to ignore them.
#TRUST_PROXY=loopback, linklocal, uniquelocal
